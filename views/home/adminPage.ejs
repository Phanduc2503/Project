<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Woofy - Admin Dashboard</title>
  <link rel="stylesheet" href="/css/home.css" />
</head>
<body>
  <header class="navbar">
    <div class="nav-left">
      <a href="/" class="logo">🐾 Woofy Admin</a>
    </div>

    <nav class="menu">
      <a href="/">Home</a>
      <a href="/breeds">Manage Breeds</a>
      <a href="/categories">Manage Categories</a>
    </nav>

    <div class="auth-actions">
      <span class="welcome-user">Admin: <%= currentUser.username %></span>
      <a href="/logout" class="btn-register">Logout</a>
    </div>
  </header>

  <main class="container">
    <section class="section">
      <div class="section-header">
        <h2>📊 Admin Dashboard</h2>
      </div>

      <div class="category-grid">
        <div class="category-card">
          <h3><%= totalBreeds %></h3>
          <p>Total Breeds</p>
        </div>

        <div class="category-card">
          <h3><%= totalCategories %></h3>
          <p>Total Categories</p>
        </div>

        <div class="category-card">
          <h3><%= totalUsers %></h3>
          <p>Total Users</p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <h2>⚙️ Quản trị hệ thống</h2>
      </div>

      <div class="hero-stats">
        <a href="/breeds" class="btn-primary">Manage Breeds</a>
        <a href="/categories" class="btn-primary">Manage Categories</a>
        <a href="/breeds/create" class="btn-primary">Add Breed</a>
        <a href="/categories/create" class="btn-primary">Add Category</a>
      </div>
    </section>
  </main>
</body>
</html>