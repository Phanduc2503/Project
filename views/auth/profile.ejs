<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Woofy - <%= user.username %>'s Profile</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/woofy-theme.css" />
  <link rel="stylesheet" href="/css/profile.css" />
</head>
<body>
  <%- include('../partials/header') %>

  <main class="profile-page">
    <div class="profile-container">
      <!-- Profile Header -->
      <div class="profile-header">
        <img src="<%= user.avatar ? user.avatar : 'https://res.cloudinary.com/dxjv0gq1f/image/upload/v1690911873/default-avatar_ow6k7b.png' %>" alt="<%= user.username %>" class="profile-avatar" />
        <h1><%= user.username %></h1>
        <p class="profile-email"><%= user.email %></p>
        <span class="profile-role-badge <%= user.role === 'admin' ? 'admin' : 'member' %>">
          <i class="fas fa-<%= user.role === 'admin' ? 'crown' : 'user' %>"></i>
          <%= user.role === 'admin' ? 'Administrator' : 'Member' %>
        </span>

        <div class="profile-actions">
          <a href="/user/favorites" class="btn btn-primary"><i class="fas fa-heart"></i> Favorites</a>
          <a href="/" class="btn btn-outline"><i class="fas fa-home"></i> Home</a>
          <% if (user.role === 'admin') { %>
            <a href="/admin" class="btn btn-outline"><i class="fas fa-cog"></i> Admin</a>
          <% } %>
          <a href="/logout" class="btn btn-ghost"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
      </div>

      <!-- Profile Grid -->
      <div class="profile-grid">
        <!-- Left Column -->
        <div class="profile-main">
          <!-- Account Info -->
          <div class="card">
            <div class="card-header">
              <h3><i class="fas fa-id-card" style="color:var(--primary-dark);"></i> Account Information</h3>
            </div>
            <div class="card-body">
              <div class="info-grid">
                <div class="info-item">
                  <div class="info-label">Username</div>
                  <div class="info-value"><%= user.username %></div>
                </div>
                <div class="info-item">
                  <div class="info-label">Email</div>
                  <div class="info-value"><%= user.email %></div>
                </div>
                <div class="info-item">
                  <div class="info-label">Role</div>
                  <div class="info-value"><%= user.role === 'admin' ? 'Administrator' : 'Member' %></div>
                </div>
                <div class="info-item">
                  <div class="info-label">Joined</div>
                  <div class="info-value"><%= user.createdAt ? new Date(user.createdAt).toLocaleDateString("en-US", { month: 'long', day: 'numeric', year: 'numeric' }) : "Recently" %></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Update Avatar -->
          <div class="card">
            <div class="card-header">
              <h3><i class="fas fa-camera" style="color:var(--primary-dark);"></i> Update Avatar</h3>
            </div>
            <div class="card-body">
              <form action="/profile/avatar" method="POST" enctype="multipart/form-data">
                <div class="upload-area">
                  <h4>Choose a new photo</h4>
                  <p>Upload a square image from your computer</p>
                  <input type="file" name="avatar" id="avatar" accept="image/*" required />
                </div>
                <button type="submit" class="upload-btn"><i class="fas fa-upload"></i> Update Avatar</button>
              </form>
            </div>
          </div>
        </div>

        <!-- Right Column -->
        <div class="profile-sidebar">
          <!-- Favorite Breeds -->
          <div class="card">
            <div class="card-header">
              <h3><i class="fas fa-heart" style="color:var(--primary-dark);"></i> Favorite Breeds</h3>
            </div>
            <div class="card-body">
              <div class="empty-state">
                <span class="empty-icon">❤️</span>
                <p>No favorites yet.</p>
                <a href="/user/breeds">Browse breeds to get started</a>
              </div>
            </div>
          </div>

          <!-- Recent Activity -->
          <div class="card">
            <div class="card-header">
              <h3><i class="fas fa-clock" style="color:var(--primary-dark);"></i> Recent Activity</h3>
            </div>
            <div class="card-body">
              <ul class="activity-list">
                <li class="activity-item">
                  <div class="activity-dot success"></div>
                  <div class="activity-text">
                    <p><span class="activity-title">Account Created</span> — Welcome to Woofy!</p>
                    <span class="activity-time"><%= user.createdAt ? new Date(user.createdAt).toLocaleDateString("en-US", { month: 'long', day: 'numeric', year: 'numeric' }) : "Today" %></span>
                  </div>
                </li>
                <li class="activity-item">
                  <div class="activity-dot brand"></div>
                  <div class="activity-text">
                    <p><span class="activity-title">Profile Viewed</span> — Your profile page</p>
                    <span class="activity-time">Just now</span>
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include("../partials/footer") %>
</body>
</html>