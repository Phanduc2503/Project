<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login - Woofy</title>
  <link rel="stylesheet" href="/css/woofy-theme.css" />
  <link rel="stylesheet" href="/css/login.css" />
</head>
<body>
  <%- include("../partials/header") %>

  <div class="auth-wrapper">
    <div class="auth-box">
      <div class="auth-brand">
        <a href="/">🐾 Woofy</a>
      </div>

      <h1>Login</h1>
      <p class="auth-subtitle">Welcome back to Woofy</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert error"><%= error %></div>
      <% } %>

      <form action="/login" method="POST" class="auth-form">
        <div class="form-group">
          <label>User Name</label>
          <input type="text" name="username" placeholder="Enter User Name" value="<%= typeof oldData !== 'undefined' && oldData.username ? oldData.username : '' %>" />
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" name="password" placeholder="Enter Password" />
        </div>
        <button type="submit">Login</button>
      </form>

      <p class="switch-link">
        Don't have an account?
        <a href="/register">Register now</a>
      </p>
    </div>
  </div>

  <%- include("../partials/footer") %>
</body>
</html>