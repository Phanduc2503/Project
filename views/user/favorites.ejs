<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Favorite Breeds - Woofy</title>
  <link rel="stylesheet" href="/css/woofy-theme.css" />
</head>
<body>
  <%- include("../partials/header") %>

  <main class="container">
    <div class="breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <span>Favorites</span>
    </div>

    <div class="page-title">
      <h1>❤️ My Favorite Breeds</h1>
      <p>Danh sách những giống chó bạn đã lưu.</p>
    </div>

    <% if (favorites.length === 0) { %>
      <div class="empty-box">
        <img src="https://cdn-icons-png.flaticon.com/512/4076/4076549.png" alt="Empty" />
        <h2>Chưa có giống chó yêu thích</h2>
        <p>Hãy khám phá các giống chó và thêm vào danh sách yêu thích.</p>
        <a href="/user/breeds" class="browse-btn">Browse Breeds</a>
      </div>
    <% } else { %>
      <div class="breed-grid large-grid">
        <% favorites.forEach(item => { %>
          <div class="breed-card">
            <div class="breed-image">
              <img src="<%= item.breedId.image && item.breedId.image.trim() !== '' ? item.breedId.image : 'https://via.placeholder.com/600x400?text=No+Image' %>"
                   alt="<%= item.breedId.name %>"
                   onerror="this.src='https://via.placeholder.com/600x400?text=No+Image'" />
              <span class="favorite-badge">❤️ Favorite</span>
            </div>
            <div class="breed-content">
              <h3><%= item.breedId.name %></h3>
              <div class="info-grid">
                <div class="info-item">
                  <span>Category</span>
                  <p><%= item.breedId.categoryId ? item.breedId.categoryId.name : "Unknown" %></p>
                </div>
                <div class="info-item">
                  <span>Origin</span>
                  <p><%= item.breedId.originCountry || "Unknown" %></p>
                </div>
                <div class="info-item">
                  <span>Life</span>
                  <p><%= item.breedId.lifeExpectancy %> years</p>
                </div>
                <div class="info-item">
                  <span>Temperament</span>
                  <p><%= item.breedId.temperament || "Updating..." %></p>
                </div>
              </div>
              <div style="display: flex; gap: 8px; margin-top: 16px; flex-wrap: wrap;">
                <a href="/breeds/<%= item.breedId._id %>" class="btn-detail">View Detail</a>
                <button class="btn-outline remove-btn" data-id="<%= item.breedId._id %>" style="padding: 10px 20px; font-size: 0.85rem;">Remove</button>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>

  <script src="/js/favorites.js"></script>
  <%- include("../partials/footer") %>
</body>
</html>