<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Breed Categories</title>

    <link rel="stylesheet" href="usercategory.css">

    <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
</head>
<body>

<div class="container">

    <!-- Sidebar -->
    <aside class="sidebar">

        <h2>Filters</h2>

        <div class="filter-group">
            <h4>TEMPERAMENT</h4>

            <label><input type="checkbox"> Friendly</label>
            <label><input type="checkbox"> Alert</label>
            <label><input type="checkbox"> Playful</label>
            <label><input type="checkbox"> Calm</label>
        </div>

        <div class="filter-group">
            <h4>LIFE EXPECTANCY</h4>

            <label><input type="radio" name="life"> All</label>
            <label><input type="radio" name="life"> Under 10 Years</label>
            <label><input type="radio" name="life"> 10 - 15 Years</label>
            <label><input type="radio" name="life"> Over 15 Years</label>
        </div>

    </aside>

    <!-- Main -->
    <main class="content">

        <h1>Breed Categories</h1>

        <p class="subtitle">
            Explore our comprehensive guide to dog breeds categorized
            to help you find the perfect companion.
        </p>

        <div class="grid">

            <div class="card">
                <img src="https://images.unsplash.com/photo-1517849845537-4d257902454a?w=600" alt="">
                <div class="card-body">
                    <h3>Small</h3>

                    <p>
                        Compact, adaptable companions perfect for apartment
                        living.
                    </p>

                    <div class="bottom">
                        <span class="tag">
                            Apartment Friendly
                        </span>

                        <i class="fa-solid fa-arrow-right"></i>
                    </div>
                </div>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1548199973-03cce0bbc87b?w=600">

                <div class="card-body">

                    <h3>Working</h3>

                    <p>
                        Strong intelligent breeds developed to perform jobs.
                    </p>

                    <div class="bottom">
                        <span class="tag">High Energy</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>

                </div>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1552053831-71594a27632d?w=600">

                <div class="card-body">

                    <h3>Large</h3>

                    <p>
                        Gentle giants with loyal personalities and sturdy build.
                    </p>

                    <div class="bottom">
                        <span class="tag">Family Friendly</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>

                </div>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1518717758536-85ae29035b6d?w=600">

                <div class="card-body">

                    <h3>Sporting</h3>

                    <p>
                        Active dogs ideal for outdoor activities and hunting.
                    </p>

                    <div class="bottom">
                        <span class="tag">Active Lifestyle</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>

                </div>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1525253086316-d0c936c814f8?w=600">

                <div class="card-body">

                    <h3>Toy</h3>

                    <p>
                        Tiny companions full of affection and personality.
                    </p>

                    <div class="bottom">
                        <span class="tag">Companion</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>

                </div>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1537151625747-768eb6cf92b2?w=600">

                <div class="card-body">

                    <h3>Terrier</h3>

                    <p>
                        Spirited, energetic dogs with fearless attitudes.
                    </p>

                    <div class="bottom">
                        <span class="tag">Spirited</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>

                </div>
            </div>

        </div>

    </main>

</div>

</body>
</html>