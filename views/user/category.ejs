<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Woofy | Categories</title>
  <link rel="stylesheet" href="/css/woofy-theme.css" />
</head>
<body>
  <%- include("../partials/header") %>

  <main class="container">
    <div class="breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <span>Categories</span>
    </div>

    <div class="page-title">
      <h1>🐾 All Categories</h1>
      <p>Khám phá các danh mục giống chó trên Woofy</p>
    </div>

    <section class="section" style="padding-top: 0;">
      <% if (categories.length === 0) { %>
        <div class="empty-box">
          <img src="https://cdn-icons-png.flaticon.com/512/4076/4076549.png" alt="Empty" />
          <h2>No Categories Found</h2>
          <p>Chưa có danh mục nào được thêm vào hệ thống.</p>
        </div>
      <% } else { %>
        <div class="category-grid">
          <% categories.forEach(category => { %>
            <div class="category-card">
              <h3><%= category.name %></h3>
              <p><%= category.description || "No description available." %></p>
              <a href="/category/<%= category._id %>" class="btn-detail">View Breeds →</a>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>

  <%- include("../partials/footer") %>
</body>
</html>