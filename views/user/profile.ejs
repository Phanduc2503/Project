<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Woofy - Profile</title>

  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/profile.css" />
</head>
<body>

  <%- include('../partials/header') %>

  <main class="profile-page">
    <div class="profile-container">

      <!-- HERO -->
      <section class="profile-hero">
        <div class="profile-hero-left">
          <span class="profile-badge">👤 MY PROFILE</span>
          <h1>Xin chào, <span><%= user.username %></span></h1>
          <p>Đây là trang thông tin tài khoản của bạn trên Woofy.</p>
        </div>

        <div class="profile-hero-right">
          <div class="hero-avatar-frame">
            <img
              src="<%= user.avatar ? user.avatar : '/images/default-avatar.png' %>"
              alt="Avatar"
              class="hero-avatar"
            />
          </div>
        </div>
      </section>

      <!-- CONTENT -->
      <section class="profile-content">
        <!-- LEFT -->
        <div class="profile-left">
          <div class="profile-card info-card">
            <div class="card-top">
              <div>
                <h2>Thông tin tài khoản</h2>
                <p>Thông tin cơ bản của tài khoản Woofy</p>
              </div>
              <span class="role-badge">
                <%= user.role ? user.role.toUpperCase() : 'USER' %>
              </span>
            </div>

            <div class="info-grid">
              <div class="info-box">
                <span class="label">Username</span>
                <strong><%= user.username %></strong>
              </div>

              <div class="info-box">
                <span class="label">Email</span>
                <strong><%= user.email %></strong>
              </div>

              <div class="info-box">
                <span class="label">Role</span>
                <strong><%= user.role %></strong>
              </div>

              <div class="info-box">
                <span class="label">Joined</span>
                <strong>
                  <%= user.createdAt
                    ? new Date(user.createdAt).toLocaleDateString("vi-VN")
                    : "N/A" %>
                </strong>
              </div>
            </div>

            <div class="profile-actions">
              <a href="/" class="btn btn-primary">Back Home</a>
              <a href="/logout" class="btn btn-outline">Logout</a>
            </div>
          </div>

          <!-- CHANGE AVATAR -->
          <div class="profile-card upload-card">
            <h2>Đổi avatar</h2>
            <p>Chọn ảnh từ máy tính để cập nhật avatar của bạn.</p>

            <form
              action="/profile/avatar"
              method="POST"
              enctype="multipart/form-data"
              class="avatar-form"
            >
              <div class="upload-dropzone">
                <div class="upload-icon">⤴</div>
                <h3>Choose avatar</h3>
                <p>Drag and drop or click to browse</p>

                <input type="file" name="avatar" id="avatar" accept="image/*" required />
              </div>

              <button type="submit" class="btn-upload">Cập nhật avatar</button>
            </form>
          </div>
        </div>

        <!-- RIGHT -->
        <div class="profile-right">
          <div class="side-card">
            <h3>📌 Tài khoản hiện tại</h3>
            <p>Bạn đang đăng nhập với email:</p>
            <strong><%= user.email %></strong>
          </div>

          <div class="side-card">
            <h3>🔒 Quyền tài khoản</h3>
            <p>
              Tài khoản của bạn là
              <strong>
                <%= user.role === "admin" ? "quản trị viên" : "người dùng thông thường" %>
              </strong>.
            </p>
          </div>
        </div>
      </section>

    </div>
  </main>

  <footer class="profile-footer">
    <div class="footer-left">Woofy</div>
    <div class="footer-center">© 2024 Woofy. All rights reserved.</div>
    <div class="footer-right">
      <a href="#">Privacy Policy</a>
      <a href="#">Terms of Service</a>
      <a href="#">Contact Us</a>
    </div>
  </footer>

</body>
</html>