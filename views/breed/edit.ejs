<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Breed</title>
    <link rel="stylesheet" href="/css/form-page.css">
</head>

<body>
    <% if (currentUser && currentUser.role==="admin" ) { %>
        <% } %>

            <div class="form-page">
                <div class="form-card">
                    <span class="form-badge">Woofy • Breed</span>
                    <h1 class="form-title">Edit Breed</h1>
                    <p class="form-subtitle">
                        Chỉnh sửa thông tin giống chó trong hệ thống Woofy.
                    </p>

                    <form action="/breeds/update/<%= breed._id %>" method="POST">
                        <div class="form-group">
                            <label class="form-label">Category</label>
                            <select name="categoryId" class="form-select" required>
                                <% categories.forEach(category=> { %>
                                    <option value="<%= category._id %>"
                                        <%=String(breed.categoryId)===String(category._id) ? "selected" : "" %>>
                                        <%= category.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Breed Name</label>
                            <input type="text" name="name" class="form-input" value="<%= breed.name %>" required>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Origin Country</label>
                            <input type="text" name="originCountry" class="form-input"
                                value="<%= breed.originCountry %>" required>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Life Expectancy</label>
                            <input type="number" name="lifeExpectancy" class="form-input"
                                value="<%= breed.lifeExpectancy %>" required>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Temperament</label>
                            <input type="text" name="temperament" class="form-input"
                                value="<%= breed.temperament || '' %>">
                        </div>

                        <div class="form-group">
                            <label class="form-label">Behavior</label>
                            <textarea name="behavior" class="form-textarea"><%= breed.behavior || '' %></textarea>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Care Requirements</label>
                            <textarea name="careRequirements"
                                class="form-textarea"><%= breed.careRequirements || '' %></textarea>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Description</label>
                            <textarea name="description" class="form-textarea"><%= breed.description || '' %></textarea>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Image URL</label>
                            <input type="text" name="image" class="form-input" value="<%= breed.image || '' %>">
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn-primary">Update Breed</button>
                            <a href="/breeds" class="btn-secondary">Back to Breeds</a>
                        </div>
                    </form>
                </div>
            </div>

</body>

</html>