<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Breeds - Woofy Admin</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/woofy-theme.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin-body">
  <%- include("../partials/admin-sidebar", { currentPage: 'breeds' }) %>

  <div class="admin-sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

  <%- include("../partials/admin-header") %>

  <main class="admin-main">
    <%- include("../partials/admin-breadcrumb", { pageTitle: 'Manage Breeds', pageIcon: 'fas fa-paw' }) %>
    <div class="admin-page-header">
      <h1><i class="fas fa-paw" style="color:var(--admin-primary);margin-right:8px;"></i> Breeds</h1>
      <div class="admin-header-actions">
        <a href="/breeds/create" class="admin-btn-primary">
          <i class="fas fa-plus"></i> Add Breed
        </a>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-table-wrapper">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Category</th>
              <th>Country</th>
              <th>Life</th>
              <th style="text-align:center;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (typeof breeds !== 'undefined' && breeds.length > 0) { %>
              <% breeds.forEach(breed => { %>
                <tr>
                  <td>
                    <a href="/breeds/<%= breed._id %>" class="breed-name" style="text-decoration:none;"><%= breed.name %></a>
                  </td>
                  <td><span class="category-tag"><%= breed.categoryId ? breed.categoryId.name : "Uncategorized" %></span></td>
                  <td><%= breed.originCountry || "—" %></td>
                  <td><%= breed.lifeExpectancy ? breed.lifeExpectancy + ' yrs' : "—" %></td>
                  <td style="text-align:center;">
                    <a href="/breeds/<%= breed._id %>" class="table-action" title="View"><i class="fas fa-eye"></i></a>
                    <% if (currentUser && currentUser.role === "admin") { %>
                      <a href="/breeds/edit/<%= breed._id %>" class="table-action" title="Edit"><i class="fas fa-edit"></i></a>
                      <a href="/breeds/delete/<%= breed._id %>" class="table-action" title="Delete" style="color:#e88080;" onclick="return confirm('Delete this breed?')"><i class="fas fa-trash"></i></a>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5">
                  <div class="admin-empty">
                    <span class="empty-icon">🐶</span>
                    <h4>No breeds found</h4>
                    <p>Get started by adding your first breed.</p>
                    <a href="/breeds/create" class="admin-btn-primary" style="display:inline-flex;margin-top:12px;">Add Breed</a>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <form action="/search" method="GET" class="admin-search-bar">
      <input type="text" name="name" placeholder="Breed name">
      <input type="text" name="country" placeholder="Country">
      <input type="text" name="temperament" placeholder="Temperament">
      <button type="submit"><i class="fas fa-search"></i> Search</button>
    </form>
  </main>

  <script>
    function toggleSidebar() {
      document.getElementById('adminSidebar').classList.toggle('open');
      document.getElementById('sidebarOverlay').classList.toggle('show');
    }
  </script>
</body>
</html>