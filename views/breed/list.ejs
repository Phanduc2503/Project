<!DOCTYPE html>
<html>

<head>
    <title>Breed List</title>
</head>

<body>

<h1>Breed List</h1>

<a href="/breeds/create">Add Breed</a>

<br><br>

<table border="1" cellpadding="10">

<tr>

<th>Name</th>

<th>Category</th>

<th>Country</th>

<th>Life</th>

<th>Action</th>

</tr>

<% breeds.forEach(breed=>{ %>

<tr>

<td>

<a href="/breeds/<%= breed._id %>">

<%= breed.name %>

</a>

</td>

<td><%= breed.categoryId.name %></td>

<td><%= breed.originCountry %></td>

<td><%= breed.lifeExpectancy %></td>

<td>

<a href="/breeds/edit/<%= breed._id %>">

Edit

</a>

|

<a href="/breeds/delete/<%= breed._id %>"
onclick="return confirm('Delete Breed?')">

Delete

</a>

</td>

</tr>

<% }) %>

<form action="/search" method="GET">

<input
type="text"
name="name"
placeholder="Breed name">

<input
type="text"
name="country"
placeholder="Country">

<input
type="text"
name="temperament"
placeholder="Temperament">

<button>

Search

</button>

</form>

</table>

</body>

</html>