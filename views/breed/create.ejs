<!DOCTYPE html>
<html>

<head>
    <title>Create Breed</title>
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/breed.css">
</head>

<body>
    <%- include("../partials/header") %>
    <h1>Create Breed</h1>

    <form action="/breeds" method="POST" class="breed-form">

        <label>Category</label>

        <select name="categoryId" required>

            <option value="">-- Select Category --</option>

            <% categories.forEach(category=> { %>

                <option value="<%= category._id %>">
                    <%= category.name %>
                </option>

                <% }) %>

        </select>

        <br><br>

        <input type="text" name="name" placeholder="Breed Name">

        <br><br>

        <input type="text" name="originCountry" placeholder="Country">

        <br><br>

        <input type="number" name="lifeExpectancy" placeholder="Life Expectancy">

        <br><br>

        <input type="text" name="temperament" placeholder="Temperament">

        <br><br>

        <input type="text" name="behavior" placeholder="Behavior">

        <br><br>

        <textarea name="careRequirements" placeholder="Care Requirements"></textarea>

        <br><br>

        <textarea name="description" placeholder="Description"></textarea>

        <br><br>

        <input type="file" name="image" accept="image/*">

        <br><br>

        <button type="submit">

            Save

        </button>

    </form>

</body>

</html>