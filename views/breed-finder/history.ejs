<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Woofy - Recommendation History</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/woofy-theme.css" />
  <link rel="stylesheet" href="/css/breed-finder.css" />
</head>
<body>
  <%- include('../partials/header') %>

  <main class="bf-main">
    <div class="bf-container">
      <div class="bf-page-header">
        <h1><i class="fas fa-history"></i> Your Breed Finder History</h1>
        <p>View your past breed recommendations and saved results.</p>
      </div>

      <% if (records && records.length > 0) { %>
        <div class="bf-history-list">
          <% records.forEach(function(record) { %>
            <div class="bf-history-card">
              <div class="bf-history-header">
                <span class="bf-history-date">
                  <i class="far fa-calendar-alt"></i> 
                  <%= new Date(record.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                </span>
                <div class="bf-history-actions">
                  <a href="/breed-finder/saved/<%= record._id %>" class="bf-btn bf-btn-sm bf-btn-outline">
                    <i class="fas fa-eye"></i> View
                  </a>
                  <button class="bf-btn bf-btn-sm bf-btn-ghost" onclick="deleteHistory('<%= record._id %>')">
                    <i class="fas fa-trash"></i>
                  </button>
                </div>
              </div>
              <div class="bf-history-body">
                <div class="bf-history-tags">
                  <% if (record.answers.living) { %><span class="bf-tag"><%= record.answers.living %></span><% } %>
                  <% if (record.answers.experience) { %><span class="bf-tag"><%= record.answers.experience %></span><% } %>
                  <% if (record.answers.family) { %><span class="bf-tag"><%= record.answers.family %></span><% } %>
                  <% if (record.answers.preferredSize) { %><span class="bf-tag"><%= record.answers.preferredSize %></span><% } %>
                  <% if (record.answers.purpose) { %><span class="bf-tag"><%= record.answers.purpose %></span><% } %>
                </div>
                <div class="bf-history-breeds">
                  <% if (record.results && record.results.length > 0) { %>
                    <% record.results.slice(0, 3).forEach(function(r) { %>
                      <span class="bf-history-breed">
                        <i class="fas fa-paw"></i> <%= r.breedName || 'Unknown' %> (<%= r.score %>%)
                      </span>
                    <% }); %>
                    <% if (record.results.length > 3) { %>
                      <span class="bf-history-more">+<%= record.results.length - 3 %> more</span>
                    <% } %>
                  <% } %>
                </div>
              </div>
              <% if (record.isSaved) { %>
                <div class="bf-history-saved-badge">
                  <i class="fas fa-bookmark"></i> Saved
                </div>
              <% } %>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="bf-empty">
          <span class="bf-empty-icon">📋</span>
          <h3>No history yet</h3>
          <p>Complete the breed finder questionnaire to see your history here.</p>
          <a href="/breed-finder" class="bf-btn bf-btn-primary">
            <i class="fas fa-search"></i> Find Your Perfect Breed
          </a>
        </div>
      <% } %>
    </div>
  </main>

  <%- include('../partials/footer') %>

  <script>
    function deleteHistory(id) {
      if (!confirm('Delete this recommendation?')) return;
      fetch('/breed-finder/delete/' + id, { method: 'POST' })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.success) location.reload();
          else alert(data.error || 'Failed to delete');
        })
        .catch(function() { alert('Error deleting'); });
    }
  </script>
</body>
</html>