<header class="navbar">
  <div class="nav-left">
    <link rel="stylesheet" href="/css/home.css" />
    <a href="/" class="logo">🐾 Woofy</a>
  </div>

  <nav class="menu">
    <a href="/">Home</a>
    <a href="/user/breeds">Breeds</a>
    <a href="/user/category">Categories</a>
    <a href="/user/favorites">Favorites</a>
    <a href="/user/profile">Profile</a>
  </nav>

  <div class="auth-actions">
    <% if (currentUser) { %>
      <span class="welcome-user">Hi, <%= currentUser.username %></span>

      <% if (currentUser.role==="admin" ) { %>
        <a href="/admin" class="btn-login">Admin Dashboard</a>
        <% } %>

          <a href="/logout" class="btn-register">Logout</a>
          <% } else { %>
            <a href="/login" class="btn-login">Login</a>
            <a href="/register" class="btn-register">Register</a>
            <% } %>
  </div>

</header>