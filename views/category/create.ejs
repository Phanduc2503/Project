<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Category - Woofy Admin</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/woofy-theme.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin-body">
  <%- include("../partials/admin-sidebar", { currentPage: 'category-create' }) %>

  <div class="admin-sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

  <%- include("../partials/admin-header") %>

  <main class="admin-main">
    <%- include("../partials/admin-breadcrumb", { pageTitle: 'Add Category', pageIcon: 'fas fa-plus-circle' }) %>
    <div class="admin-card admin-form-card">
      <div class="admin-card-body">
        <span class="form-badge">Woofy • Category</span>
        <h1 class="form-title">Create Category</h1>
        <p class="form-subtitle">Add a new category to organize dog breeds.</p>

        <form action="/categories" method="POST">
          <div class="admin-form-group">
            <label class="admin-form-label">Category Name</label>
            <input type="text" name="name" class="admin-form-input" placeholder="e.g. Working Dogs" required>
          </div>

          <div class="admin-form-group">
            <label class="admin-form-label">Description</label>
            <textarea name="description" class="admin-form-textarea" placeholder="Describe this category..."></textarea>
          </div>

          <div class="admin-form-actions">
            <button type="submit" class="admin-btn-primary"><i class="fas fa-save"></i> Save Category</button>
            <a href="/categories" class="admin-btn-secondary"><i class="fas fa-arrow-left"></i> Back to Categories</a>
          </div>
        </form>
      </div>
    </div>
  </main>

  <script>
    function toggleSidebar() {
      document.getElementById('adminSidebar').classList.toggle('open');
      document.getElementById('sidebarOverlay').classList.toggle('show');
    }
  </script>
</body>
</html>
