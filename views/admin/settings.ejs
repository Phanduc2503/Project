<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Woofy - Settings</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/woofy-theme.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin-body">
  <div class="admin-sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

  <%- include("../partials/admin-sidebar", { currentPage: 'settings' }) %>

  <header class="admin-topbar">
    <div class="admin-topbar-left">
      <button class="admin-toggle-sidebar" onclick="toggleSidebar()" aria-label="Toggle sidebar">
        <i class="fas fa-bars"></i>
      </button>
      <div class="admin-topbar-search">
        <i class="fas fa-search"></i>
        <input type="text" placeholder="Search..." disabled />
      </div>
    </div>
    <div class="admin-topbar-right">
      <div class="admin-profile" id="profileDropdownToggle">
        <div class="avatar">
          <%= currentUser ? currentUser.username.charAt(0).toUpperCase() : 'A' %>
        </div>
        <span class="name"><%= currentUser ? currentUser.username : 'Admin' %></span>
        <i class="fas fa-chevron-down" style="font-size:0.7rem;color:var(--admin-text-muted);"></i>
      </div>
      <div class="admin-profile-dropdown" id="profileDropdown">
        <a href="/user/profile" class="dropdown-item"><i class="fas fa-user"></i> My Profile</a>
        <a href="/admin" class="dropdown-item"><i class="fas fa-th-large"></i> Dashboard</a>
        <a href="/breeds" class="dropdown-item"><i class="fas fa-paw"></i> Breeds</a>
        <div class="dropdown-divider"></div>
        <a href="/logout" class="dropdown-item dropdown-danger"><i class="fas fa-sign-out-alt"></i> Logout</a>
      </div>
    </div>
  </header>

  <main class="admin-main">
    <%- include("../partials/admin-breadcrumb", { pageTitle: 'Settings', pageIcon: 'fas fa-cog' }) %>

    <% if (success) { %>
      <div class="admin-alert success">
        <i class="fas fa-check-circle"></i> <%= success %>
        <button onclick="this.parentElement.remove()" style="margin-left:auto;background:none;border:none;color:inherit;cursor:pointer;font-size:1rem;">&times;</button>
      </div>
    <% } %>
    <% if (error) { %>
      <div class="admin-alert error">
        <i class="fas fa-exclamation-circle"></i> <%= error %>
        <button onclick="this.parentElement.remove()" style="margin-left:auto;background:none;border:none;color:inherit;cursor:pointer;font-size:1rem;">&times;</button>
      </div>
    <% } %>

    <div class="admin-card">
      <div class="admin-card-header">
        <h3><i class="fas fa-cog" style="color:var(--admin-primary);"></i> General Settings</h3>
      </div>
      <div class="admin-card-body">
        <form method="POST" action="/admin/settings" style="max-width:600px;">
          <div class="form-group">
            <label for="siteName">Site Name</label>
            <input type="text" id="siteName" name="siteName" value="Woofy" class="form-control" />
          </div>
          <div class="form-group">
            <label for="siteDescription">Site Description</label>
            <textarea id="siteDescription" name="siteDescription" class="form-control" rows="3">A comprehensive dog breed database for dog lovers.</textarea>
          </div>
          <div class="form-group">
            <label for="itemsPerPage">Items Per Page</label>
            <input type="number" id="itemsPerPage" name="itemsPerPage" value="12" min="6" max="50" class="form-control" />
          </div>
          <div class="form-actions">
            <button type="submit" class="admin-btn-primary">
              <i class="fas fa-save"></i> Save Settings
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>

  <style>
    .form-group { margin-bottom: 20px; }
    .form-group label { display: block; font-weight: 600; font-size: 0.9rem; color: var(--admin-text); margin-bottom: 6px; }
    .form-control { width: 100%; padding: 10px 14px; border: 1px solid var(--admin-border); border-radius: var(--admin-radius-sm); font-size: 0.9rem; font-family: inherit; color: var(--admin-text); outline: none; transition: border-color 0.2s; box-sizing: border-box; }
    .form-control:focus { border-color: var(--admin-primary); box-shadow: 0 0 0 3px rgba(196,149,106,0.1); }
    textarea.form-control { resize: vertical; min-height: 80px; }
    .form-actions { margin-top: 24px; }
    .admin-btn-primary { display: inline-flex; align-items: center; gap: 8px; padding: 12px 28px; background: linear-gradient(135deg, var(--admin-primary), var(--admin-primary-dark)); color: #fff; border: none; border-radius: 50px; font-weight: 600; font-size: 0.9rem; cursor: pointer; transition: var(--admin-transition); text-decoration: none; }
    .admin-btn-primary:hover { transform: translateY(-1px); box-shadow: 0 4px 16px rgba(166,123,91,0.25); }

    .admin-alert { display: flex; align-items: center; gap: 10px; padding: 14px 20px; border-radius: var(--admin-radius-sm); margin-bottom: 20px; font-size: 0.9rem; font-weight: 500; animation: adminFadeUp 0.3s ease; }
    .admin-alert.success { background: rgba(123,196,127,0.12); color: #2d7a31; border: 1px solid rgba(123,196,127,0.2); }
    .admin-alert.error { background: rgba(232,128,128,0.12); color: #991b1b; border: 1px solid rgba(232,128,128,0.2); }
    .admin-alert i { font-size: 1.1rem; }

    .admin-profile { position: relative; cursor: pointer; }
    .admin-profile-dropdown { position: absolute; top: calc(100% + 8px); right: 0; width: 200px; background: #fff; border: 1px solid var(--admin-border); border-radius: var(--admin-radius-sm); box-shadow: 0 8px 30px rgba(0,0,0,0.1); z-index: 2000; display: none; padding: 6px; opacity: 0; transform: translateY(-4px); transition: opacity 0.2s ease, transform 0.2s ease; }
    .admin-profile-dropdown.show { display: block; opacity: 1; transform: translateY(0); }
    .admin-profile-dropdown .dropdown-item { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 8px; text-decoration: none; color: var(--admin-text-light); font-size: 0.88rem; font-weight: 500; transition: background 0.15s ease; }
    .admin-profile-dropdown .dropdown-item:hover { background: var(--admin-accent); color: var(--admin-primary-dark); }
    .admin-profile-dropdown .dropdown-item i { width: 18px; text-align: center; }
    .admin-profile-dropdown .dropdown-divider { height: 1px; background: var(--admin-border); margin: 4px 0; }
    .admin-profile-dropdown .dropdown-danger { color: #e88080; }
    .admin-profile-dropdown .dropdown-danger:hover { background: #fee2e2 !important; color: #991b1b !important; }
  </style>

  <script>
    function toggleSidebar() {
      document.getElementById('adminSidebar').classList.toggle('open');
      document.getElementById('sidebarOverlay').classList.toggle('show');
    }
    (function() {
      var toggle = document.getElementById('profileDropdownToggle');
      var dropdown = document.getElementById('profileDropdown');
      if (toggle && dropdown) {
        toggle.addEventListener('click', function(e) { e.stopPropagation(); dropdown.classList.toggle('show'); });
        document.addEventListener('click', function(e) { if (!toggle.contains(e.target) && !dropdown.contains(e.target)) { dropdown.classList.remove('show'); } });
      }
    })();
    document.addEventListener('DOMContentLoaded', function() {
      setTimeout(function() {
        document.querySelectorAll('.admin-alert').forEach(function(el) { el.remove(); });
      }, 5000);
    });
  </script>
</body>
</html>