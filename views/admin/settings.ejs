<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Woofy - Settings</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/woofy-theme.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin-body">
  <div class="admin-sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

  <%- include("../partials/admin-sidebar", { currentPage: 'settings' }) %>

  <%- include("../partials/admin-header") %>

  <main class="admin-main">
    <%- include("../partials/admin-breadcrumb", { pageTitle: 'Settings', pageIcon: 'fas fa-cog' }) %>

    <% if (success) { %>
      <div class="admin-alert success">
        <i class="fas fa-check-circle"></i> <%= success %>
        <button onclick="this.parentElement.remove()" style="margin-left:auto;background:none;border:none;color:inherit;cursor:pointer;font-size:1rem;">&times;</button>
      </div>
    <% } %>
    <% if (error) { %>
      <div class="admin-alert error">
        <i class="fas fa-exclamation-circle"></i> <%= error %>
        <button onclick="this.parentElement.remove()" style="margin-left:auto;background:none;border:none;color:inherit;cursor:pointer;font-size:1rem;">&times;</button>
      </div>
    <% } %>

    <div class="admin-card">
      <div class="admin-card-header">
        <h3><i class="fas fa-cog" style="color:var(--admin-primary);"></i> General Settings</h3>
      </div>
      <div class="admin-card-body">
        <form method="POST" action="/admin/settings" style="max-width:600px;">
          <div class="form-group">
            <label for="siteName">Site Name</label>
            <input type="text" id="siteName" name="siteName" value="Woofy" class="form-control" />
          </div>
          <div class="form-group">
            <label for="siteDescription">Site Description</label>
            <textarea id="siteDescription" name="siteDescription" class="form-control" rows="3">A comprehensive dog breed database for dog lovers.</textarea>
          </div>
          <div class="form-group">
            <label for="itemsPerPage">Items Per Page</label>
            <input type="number" id="itemsPerPage" name="itemsPerPage" value="12" min="6" max="50" class="form-control" />
          </div>
          <div class="form-actions">
            <button type="submit" class="admin-btn-primary">
              <i class="fas fa-save"></i> Save Settings
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>

  <style>
    .form-group { margin-bottom: 20px; }
    .form-group label { display: block; font-weight: 600; font-size: 0.9rem; color: var(--admin-text); margin-bottom: 6px; }
    .form-control { width: 100%; padding: 10px 14px; border: 1px solid var(--admin-border); border-radius: var(--admin-radius-sm); font-size: 0.9rem; font-family: inherit; color: var(--admin-text); outline: none; transition: border-color 0.2s; box-sizing: border-box; }
    .form-control:focus { border-color: var(--admin-primary); box-shadow: 0 0 0 3px rgba(196,149,106,0.1); }
    textarea.form-control { resize: vertical; min-height: 80px; }
    .form-actions { margin-top: 24px; }
    .admin-btn-primary { display: inline-flex; align-items: center; gap: 8px; padding: 12px 28px; background: linear-gradient(135deg, var(--admin-primary), var(--admin-primary-dark)); color: #fff; border: none; border-radius: 50px; font-weight: 600; font-size: 0.9rem; cursor: pointer; transition: var(--admin-transition); text-decoration: none; }
    .admin-btn-primary:hover { transform: translateY(-1px); box-shadow: 0 4px 16px rgba(166,123,91,0.25); }

    .admin-alert { display: flex; align-items: center; gap: 10px; padding: 14px 20px; border-radius: var(--admin-radius-sm); margin-bottom: 20px; font-size: 0.9rem; font-weight: 500; animation: adminFadeUp 0.3s ease; }
    .admin-alert.success { background: rgba(123,196,127,0.12); color: #2d7a31; border: 1px solid rgba(123,196,127,0.2); }
    .admin-alert.error { background: rgba(232,128,128,0.12); color: #991b1b; border: 1px solid rgba(232,128,128,0.2); }
    .admin-alert i { font-size: 1.1rem; }

  </style>

  <script>
    function toggleSidebar() {
      document.getElementById('adminSidebar').classList.toggle('open');
      document.getElementById('sidebarOverlay').classList.toggle('show');
    }
    document.addEventListener('DOMContentLoaded', function() {
      setTimeout(function() {
        document.querySelectorAll('.admin-alert').forEach(function(el) { el.remove(); });
      }, 5000);
    });
  </script>
</body>
</html>