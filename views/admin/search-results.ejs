<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Search Results: <%= query %> - Woofy Admin</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/woofy-theme.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin-body">
  <div class="admin-sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>
  <%- include("../partials/admin-sidebar", { currentPage: 'search' }) %>
  <%- include("../partials/admin-header") %>

  <main class="admin-main">
    <%- include("../partials/admin-breadcrumb", { pageTitle: 'Search Results', pageIcon: 'fas fa-search' }) %>

    <div class="admin-page-header">
      <div>
        <h1><i class="fas fa-search" style="color:var(--admin-primary);margin-right:10px;"></i> Search Results</h1>
        <p style="color:var(--admin-text-light);font-size:0.9rem;margin-top:4px;">
          <%= totalResults %> result<%= totalResults !== 1 ? 's' : '' %> for "<strong><%= query %></strong>"
        </p>
      </div>
      <div class="admin-header-actions">
        <a href="/admin" class="admin-btn-secondary" style="padding:10px 20px;text-decoration:none;">
          <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
      </div>
    </div>

    <!-- Breeds Section -->
    <div class="admin-card">
      <div class="admin-card-header">
        <h3><i class="fas fa-paw" style="color:var(--admin-primary);"></i> Breeds (<%= breeds.length %>)</h3>
        <a href="/breeds" class="card-action">Manage Breeds <i class="fas fa-arrow-right"></i></a>
      </div>
      <div class="admin-card-body" style="padding:0;">
        <% if (breeds && breeds.length > 0) { %>
          <div class="admin-table-wrapper">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Category</th>
                  <th>Origin</th>
                  <th style="text-align:center;">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% breeds.forEach(function(b) { %>
                  <tr>
                    <td><span class="breed-name"><%= b.name %></span></td>
                    <td><span class="category-tag"><%= b.categoryId ? b.categoryId.name : 'Uncategorized' %></span></td>
                    <td><%= b.originCountry || '—' %></td>
                    <td style="text-align:center;">
                      <a href="/breeds/<%= b._id %>" class="table-action" title="View"><i class="fas fa-eye"></i></a>
                      <a href="/breeds/edit/<%= b._id %>" class="table-action" title="Edit"><i class="fas fa-edit"></i></a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="admin-empty" style="padding:32px 20px;">
            <span class="empty-icon">🐶</span>
            <h4>No breeds found</h4>
            <p>No breeds match your search query.</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Categories Section -->
    <div class="admin-card">
      <div class="admin-card-header">
        <h3><i class="fas fa-folder" style="color:var(--admin-primary);"></i> Categories (<%= categories.length %>)</h3>
        <a href="/categories" class="card-action">Manage Categories <i class="fas fa-arrow-right"></i></a>
      </div>
      <div class="admin-card-body" style="padding:0;">
        <% if (categories && categories.length > 0) { %>
          <div class="admin-table-wrapper">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Description</th>
                  <th style="text-align:center;">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% categories.forEach(function(c) { %>
                  <tr>
                    <td><span class="breed-name"><%= c.name %></span></td>
                    <td><%= c.description || '—' %></td>
                    <td style="text-align:center;">
                      <a href="/categories/edit/<%= c._id %>" class="table-action" title="Edit"><i class="fas fa-edit"></i></a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="admin-empty" style="padding:32px 20px;">
            <span class="empty-icon">📁</span>
            <h4>No categories found</h4>
            <p>No categories match your search query.</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Users Section -->
    <div class="admin-card">
      <div class="admin-card-header">
        <h3><i class="fas fa-users" style="color:var(--admin-primary);"></i> Users (<%= users.length %>)</h3>
        <a href="/admin/users" class="card-action">Manage Users <i class="fas fa-arrow-right"></i></a>
      </div>
      <div class="admin-card-body" style="padding:0;">
        <% if (users && users.length > 0) { %>
          <div class="admin-table-wrapper">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Username</th>
                  <th>Email</th>
                  <th style="text-align:center;">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% users.forEach(function(u) { %>
                  <tr>
                    <td>
                      <div style="display:flex;align-items:center;gap:10px;">
                        <div style="width:32px;height:32px;border-radius:50%;overflow:hidden;flex-shrink:0;background:linear-gradient(135deg,var(--admin-primary),var(--admin-primary-dark));">
                          <% if (u.avatar) { %>
                            <img src="<%= u.avatar %>" alt="<%= u.username %>" style="width:100%;height:100%;object-fit:cover;" />
                          <% } else { %>
                            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:0.75rem;font-weight:700;"><%= u.username.charAt(0).toUpperCase() %></div>
                          <% } %>
                        </div>
                        <span class="breed-name"><%= u.username %></span>
                      </div>
                    </td>
                    <td><span style="color:var(--admin-text-light);font-size:0.85rem;"><%= u.email %></span></td>
                    <td style="text-align:center;">
                      <a href="/admin/users/<%= u._id %>" class="table-action" title="View"><i class="fas fa-eye"></i></a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="admin-empty" style="padding:32px 20px;">
            <span class="empty-icon">👥</span>
            <h4>No users found</h4>
            <p>No users match your search query.</p>
          </div>
        <% } %>
      </div>
    </div>

  </main>

  <style>
    .admin-pagination { display:flex; justify-content:center; align-items:center; gap:6px; margin-top:24px; flex-wrap:wrap; }
    .admin-pagination-btn { display:inline-flex; align-items:center; justify-content:center; min-width:40px; height:40px; padding:0 10px; border-radius:10px; text-decoration:none; font-weight:600; font-size:0.88rem; background:#fff; color:var(--admin-text-light); border:1px solid var(--admin-border); transition:var(--admin-transition); }
    .admin-pagination-btn:hover { border-color:var(--admin-primary-light); background:var(--admin-accent); color:var(--admin-primary-dark); }
    .admin-pagination-btn.active { background:linear-gradient(135deg,var(--admin-primary),var(--admin-primary-dark)); color:#fff; border-color:transparent; box-shadow:0 4px 12px rgba(166,123,91,0.25); }
    .page-link { min-width:40px; height:40px; padding:0; display:inline-flex; align-items:center; justify-content:center; text-decoration:none; }
  </style>

  <script>
    function toggleSidebar() {
      document.getElementById('adminSidebar').classList.toggle('open');
      document.getElementById('sidebarOverlay').classList.toggle('show');
    }
  </script>
</body>
</html>