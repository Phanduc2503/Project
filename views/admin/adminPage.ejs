<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Woofy - Admin Dashboard</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/woofy-theme.css" />
  <link rel="stylesheet" href="/css/admin.css" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
</head>
<body class="admin-body">
  <!-- Sidebar Overlay (mobile) -->
  <div class="admin-sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

  <%- include("../partials/admin-sidebar", { currentPage: 'dashboard' }) %>

  <!-- Top Navbar -->
  <%- include("../partials/admin-header") %>

  <!-- Main Content -->
  <main class="admin-main">
    <!-- Dashboard Header -->
    <div class="admin-dash-header">
      <div>
        <h1>
          Dashboard
          <small>Welcome back! Here's what's happening with Woofy.</small>
        </h1>
      </div>
      <div class="header-actions">
        <div class="admin-date-picker">
          <button class="btn-date" id="dateFilterBtn">
            <i class="fas fa-calendar-alt"></i>
            <span id="dateLabel">
              <% if (currentRange === 'today') { %>Today<% }
              else if (currentRange === 'week') { %>This Week<% }
              else if (currentRange === 'month') { %>This Month<% }
              else if (currentRange === 'year') { %>This Year<% }
              else { %>All Time<% } %>
            </span>
            <i class="fas fa-chevron-down" style="font-size:0.65rem;"></i>
          </button>
          <div class="admin-date-dropdown" id="dateDropdown">
            <a href="/admin?range=all" class="dropdown-item <%= currentRange === 'all' ? 'active' : '' %>" data-range="all"><i class="fas fa-infinity"></i> All Time</a>
            <a href="/admin?range=today" class="dropdown-item <%= currentRange === 'today' ? 'active' : '' %>" data-range="today"><i class="fas fa-sun"></i> Today</a>
            <a href="/admin?range=week" class="dropdown-item <%= currentRange === 'week' ? 'active' : '' %>" data-range="week"><i class="fas fa-calendar-week"></i> This Week</a>
            <a href="/admin?range=month" class="dropdown-item <%= currentRange === 'month' ? 'active' : '' %>" data-range="month"><i class="fas fa-calendar-alt"></i> This Month</a>
            <a href="/admin?range=year" class="dropdown-item <%= currentRange === 'year' ? 'active' : '' %>" data-range="year"><i class="fas fa-calendar-check"></i> This Year</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats Cards -->
    <div class="admin-stats-row">
      <a href="/breeds" class="admin-stat-card" style="text-decoration:none;cursor:pointer;">
        <div class="stat-icon breeds">
          <i class="fas fa-paw"></i>
        </div>
        <div class="stat-info">
          <div class="stat-label">Total Breeds</div>
          <div class="stat-number"><%= totalBreeds %></div>
          <div class="stat-change up">
            <i class="fas fa-arrow-up"></i> All breeds in database
          </div>
        </div>
      </a>

      <a href="/categories" class="admin-stat-card" style="text-decoration:none;cursor:pointer;">
        <div class="stat-icon categories">
          <i class="fas fa-folder"></i>
        </div>
        <div class="stat-info">
          <div class="stat-label">Total Categories</div>
          <div class="stat-number"><%= totalCategories %></div>
          <div class="stat-change up">
            <i class="fas fa-arrow-up"></i> Breed categories
          </div>
        </div>
      </a>

      <a href="/admin/users" class="admin-stat-card" style="text-decoration:none;cursor:pointer;">
        <div class="stat-icon users">
          <i class="fas fa-users"></i>
        </div>
        <div class="stat-info">
          <div class="stat-label">Total Users</div>
          <div class="stat-number"><%= totalUsers %></div>
          <div class="stat-change up">
            <i class="fas fa-arrow-up"></i> Registered accounts
          </div>
        </div>
      </a>

      <a href="/admin/favorites" class="admin-stat-card" style="text-decoration:none;cursor:pointer;">
        <div class="stat-icon favorites">
          <i class="fas fa-heart"></i>
        </div>
        <div class="stat-info">
          <div class="stat-label">Total Favorites</div>
          <div class="stat-number"><%= totalFavorites %></div>
          <div class="stat-change up">
            <i class="fas fa-arrow-up"></i> Saved favorites
          </div>
        </div>
      </a>

      <a href="/breed-finder" class="admin-stat-card" style="text-decoration:none;cursor:pointer;">
        <div class="stat-icon" style="background:rgba(123,196,127,0.12);color:#5aad5e;">
          <i class="fas fa-robot"></i>
        </div>
        <div class="stat-info">
          <div class="stat-label">Breed Finder Uses</div>
          <div class="stat-number"><%= totalBreedFinderUses || 0 %></div>
          <div class="stat-change up">
            <i class="fas fa-arrow-up"></i> Top: <%= topRecommendedBreed || 'N/A' %>
          </div>
        </div>
      </a>
    </div>

    <!-- Quick Actions -->
    <div class="admin-quick-actions">
      <a href="/breeds/create" class="admin-quick-action">
        <div class="qa-icon"><i class="fas fa-plus"></i></div>
        <div class="qa-label">Add Breed</div>
        <div class="qa-desc">Create a new breed entry</div>
      </a>
      <a href="/categories/create" class="admin-quick-action">
        <div class="qa-icon"><i class="fas fa-plus"></i></div>
        <div class="qa-label">Add Category</div>
        <div class="qa-desc">Create a new category</div>
      </a>
      <a href="/admin/users" class="admin-quick-action">
        <div class="qa-icon"><i class="fas fa-users-cog"></i></div>
        <div class="qa-label">Manage Users</div>
        <div class="qa-desc">View and manage users</div>
      </a>
      <a href="/admin/reports" class="admin-quick-action">
        <div class="qa-icon"><i class="fas fa-chart-bar"></i></div>
        <div class="qa-label">View Reports</div>
        <div class="qa-desc">Analytics and insights</div>
      </a>
    </div>

    <!-- 2-Column Grid: Notifications + Chart -->
    <div class="admin-grid-2col">
      <!-- Notifications -->
      <div class="admin-card">
        <div class="admin-card-header">
          <h3><i class="fas fa-bell" style="color:var(--admin-primary);"></i> Notifications</h3>
          <a href="/admin/notifications" class="card-action">View All <i class="fas fa-arrow-right"></i></a>
        </div>
        <div class="admin-card-body" style="padding:0;">
          <% if (recentNotifications && recentNotifications.length > 0) { %>
            <ul class="admin-notif-list">
              <% recentNotifications.forEach(function(notif) { %>
                <li class="admin-notif-item <%= notif.read ? '' : 'unread' %>">
                  <span class="admin-notif-icon"><%= notif.icon %></span>
                  <div class="admin-notif-content">
                    <div class="admin-notif-title"><%= notif.title %></div>
                    <div class="admin-notif-desc"><%= notif.description %></div>
                    <div class="admin-notif-time"><%= new Date(notif.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></div>
                  </div>
                  <% if (!notif.read) { %>
                    <span class="admin-notif-dot"></span>
                  <% } %>
                </li>
              <% }); %>
            </ul>
          <% } else { %>
            <div class="admin-empty" style="padding:32px 20px;">
              <span class="empty-icon">&#x1F514;</span>
              <h4>No notifications</h4>
              <p>Notifications will appear here when actions occur.</p>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Chart -->
      <div class="admin-card">
        <div class="admin-card-header">
          <h3><i class="fas fa-chart-pie" style="color:var(--admin-primary);"></i> Overview</h3>
        </div>
        <div class="admin-card-body">
          <div class="chart-container">
            <canvas id="dashboardChart"></canvas>
          </div>
        </div>
      </div>
    </div>

    <!-- Recent Breeds Table -->
    <div class="admin-card">
      <div class="admin-card-header">
        <h3><i class="fas fa-paw" style="color:var(--admin-primary);"></i> Recent Breeds</h3>
        <a href="/breeds" class="card-action">Manage Breeds <i class="fas fa-arrow-right"></i></a>
      </div>
      <div class="admin-card-body" style="padding:0;">
        <% if (recentBreeds && recentBreeds.length > 0) { %>
          <div class="admin-table-wrapper">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Breed</th>
                  <th>Category</th>
                  <th>Origin</th>
                  <th>Life Span</th>
                  <th>Status</th>
                  <th style="text-align:center;">Action</th>
                </tr>
              </thead>
              <tbody>
                <% recentBreeds.forEach(function(breed) { %>
                  <tr>
                    <td>
                      <span class="breed-name"><%= breed.name %></span>
                    </td>
                    <td>
                      <span class="category-tag"><%= breed.categoryId ? breed.categoryId.name : 'Uncategorized' %></span>
                    </td>
                    <td><%= breed.originCountry || '\u2014' %></td>
                    <td><%= breed.lifeExpectancy ? breed.lifeExpectancy + ' years' : '\u2014' %></td>
                    <td>
                      <span class="status-badge active">Active</span>
                    </td>
                    <td style="text-align:center;">
                      <a href="/breeds/<%= breed._id %>" class="table-action" title="View details">
                        <i class="fas fa-eye"></i>
                      </a>
                      <a href="/breeds/edit/<%= breed._id %>" class="table-action" title="Edit">
                        <i class="fas fa-edit"></i>
                      </a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="admin-empty">
            <span class="empty-icon">&#x1F436;</span>
            <h4>No breeds yet</h4>
            <p>Start by adding your first breed to the database.</p>
            <a href="/breeds/create" style="display:inline-block;margin-top:12px;padding:10px 24px;background:var(--admin-primary);color:#fff;border-radius:50px;font-weight:600;font-size:0.88rem;text-decoration:none;">Add First Breed</a>
          </div>
        <% } %>
      </div>
    </div>
  </main>

  <style>
    /* Date picker dropdown */
    .admin-date-picker { position: relative; }
    .admin-date-dropdown {
      position: absolute;
      top: calc(100% + 6px);
      right: 0;
      width: 220px;
      background: #fff;
      border: 1px solid var(--admin-border);
      border-radius: var(--admin-radius-sm);
      box-shadow: 0 8px 30px rgba(0,0,0,0.1);
      z-index: 2000;
      display: none;
      padding: 6px;
    }
    .admin-date-dropdown.show { display: block; }
    .admin-date-dropdown .dropdown-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      border-radius: 8px;
      text-decoration: none;
      color: var(--admin-text-light);
      font-size: 0.88rem;
      font-weight: 500;
      transition: background 0.15s ease;
    }
    .admin-date-dropdown .dropdown-item:hover { background: var(--admin-accent); color: var(--admin-primary-dark); }
    .admin-date-dropdown .dropdown-item.active { background: var(--admin-sidebar-active); color: var(--admin-primary-dark); font-weight: 600; }
    .admin-date-dropdown .dropdown-item i { width: 18px; text-align: center; font-size: 0.9rem; }
  </style>

  <script>
    // ===== SIDEBAR TOGGLE =====
    function toggleSidebar() {
      const sidebar = document.getElementById('adminSidebar');
      const overlay = document.getElementById('sidebarOverlay');
      sidebar.classList.toggle('open');
      overlay.classList.toggle('show');
    }

    // ===== DATE FILTER DROPDOWN =====
    (function() {
      const btn = document.getElementById('dateFilterBtn');
      const dropdown = document.getElementById('dateDropdown');

      if (btn && dropdown) {
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          dropdown.classList.toggle('show');
        });

        document.addEventListener('click', function(e) {
          if (!btn.contains(e.target) && !dropdown.contains(e.target)) {
            dropdown.classList.remove('show');
          }
        });
      }
    })();

    // ===== CHART.JS =====
    document.addEventListener('DOMContentLoaded', function() {
      const canvas = document.getElementById('dashboardChart');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: ['Breeds', 'Categories', 'Users', 'Favorites'],
          datasets: [{
            data: [
              <%= totalBreeds || 0 %>,
              <%= totalCategories || 0 %>,
              <%= totalUsers || 0 %>,
              <%= totalFavorites || 0 %>
            ],
            backgroundColor: ['#c4956a', '#7bc47f', '#6ab0e8', '#e88080'],
            borderWidth: 0,
            hoverOffset: 8
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '65%',
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                padding: 16,
                usePointStyle: true,
                pointStyle: 'circle',
                font: { family: 'Inter, system-ui, sans-serif', size: 12 },
                color: '#4a3728'
              }
            }
          }
        }
      });
    });
  </script>
</body>
</html>