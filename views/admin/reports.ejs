<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Woofy - Reports</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/woofy-theme.css" />
  <link rel="stylesheet" href="/css/admin.css" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
</head>
<body class="admin-body">
  <div class="admin-sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

  <%- include("../partials/admin-sidebar", { currentPage: 'reports' }) %>

  <header class="admin-topbar">
    <div class="admin-topbar-left">
      <button class="admin-toggle-sidebar" onclick="toggleSidebar()" aria-label="Toggle sidebar">
        <i class="fas fa-bars"></i>
      </button>
      <div class="admin-topbar-search">
        <i class="fas fa-search"></i>
        <input type="text" placeholder="Search..." disabled />
      </div>
    </div>
    <div class="admin-topbar-right">
      <div class="admin-profile" id="profileDropdownToggle">
        <div class="avatar">
          <%= currentUser ? currentUser.username.charAt(0).toUpperCase() : 'A' %>
        </div>
        <span class="name"><%= currentUser ? currentUser.username : 'Admin' %></span>
        <i class="fas fa-chevron-down" style="font-size:0.7rem;color:var(--admin-text-muted);"></i>
      </div>
      <div class="admin-profile-dropdown" id="profileDropdown">
        <a href="/user/profile" class="dropdown-item"><i class="fas fa-user"></i> My Profile</a>
        <a href="/admin" class="dropdown-item"><i class="fas fa-th-large"></i> Dashboard</a>
        <a href="/breeds" class="dropdown-item"><i class="fas fa-paw"></i> Breeds</a>
        <div class="dropdown-divider"></div>
        <a href="/logout" class="dropdown-item dropdown-danger"><i class="fas fa-sign-out-alt"></i> Logout</a>
      </div>
    </div>
  </header>

  <main class="admin-main">
    <%- include("../partials/admin-breadcrumb", { pageTitle: 'Reports', pageIcon: 'fas fa-chart-bar' }) %>

    <!-- Stats Overview -->
    <div class="admin-stats-row">
      <div class="admin-stat-card" style="text-decoration:none;">
        <div class="stat-icon breeds"><i class="fas fa-paw"></i></div>
        <div class="stat-info">
          <div class="stat-label">Total Breeds</div>
          <div class="stat-number"><%= totalBreeds %></div>
        </div>
      </div>
      <div class="admin-stat-card" style="text-decoration:none;">
        <div class="stat-icon categories"><i class="fas fa-folder"></i></div>
        <div class="stat-info">
          <div class="stat-label">Total Categories</div>
          <div class="stat-number"><%= totalCategories %></div>
        </div>
      </div>
      <div class="admin-stat-card" style="text-decoration:none;">
        <div class="stat-icon users"><i class="fas fa-users"></i></div>
        <div class="stat-info">
          <div class="stat-label">Total Users</div>
          <div class="stat-number"><%= totalUsers %></div>
        </div>
      </div>
      <div class="admin-stat-card" style="text-decoration:none;">
        <div class="stat-icon favorites"><i class="fas fa-heart"></i></div>
        <div class="stat-info">
          <div class="stat-label">Total Favorites</div>
          <div class="stat-number"><%= totalFavorites %></div>
        </div>
      </div>
    </div>

    <!-- Charts Row -->
    <div class="admin-grid-2col">
      <!-- Category Distribution -->
      <div class="admin-card">
        <div class="admin-card-header">
          <h3><i class="fas fa-chart-pie" style="color:var(--admin-primary);"></i> Category Distribution</h3>
        </div>
        <div class="admin-card-body">
          <div class="chart-container" style="height:260px;">
            <canvas id="categoryChart"></canvas>
          </div>
        </div>
      </div>

      <!-- Most Favorited Breeds -->
      <div class="admin-card">
        <div class="admin-card-header">
          <h3><i class="fas fa-trophy" style="color:var(--admin-primary);"></i> Most Favorited Breeds</h3>
        </div>
        <div class="admin-card-body">
          <div style="padding:8px 0;">
            <% if (popularBreeds && popularBreeds.length > 0) { %>
              <% popularBreeds.slice(0, 5).forEach(function(b, i) { %>
                <div style="display:flex;align-items:center;gap:12px;padding:8px 0;border-bottom:1px solid var(--admin-border);">
                  <div style="width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,var(--admin-primary),var(--admin-primary-dark));color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;flex-shrink:0;"><%= i + 1 %></div>
                  <div style="flex:1;font-weight:600;font-size:0.88rem;color:var(--admin-text);"><%= b.name %></div>
                  <div style="font-size:0.82rem;color:var(--admin-text-muted);"><%= b.count %> fav<% if (b.count !== 1) { %>s<% } %></div>
                </div>
              <% }); %>
            <% } else { %>
              <div class="admin-empty" style="padding:20px;">
                <h4>No favorites data yet</h4>
                <p>Favorites will appear as users save breeds.</p>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- User Registrations Chart -->
    <div class="admin-card">
      <div class="admin-card-header">
        <h3><i class="fas fa-user-plus" style="color:var(--admin-primary);"></i> User Registrations (Last 7 Days)</h3>
      </div>
      <div class="admin-card-body">
        <div class="chart-container" style="height:240px;">
          <canvas id="userChart"></canvas>
        </div>
      </div>
    </div>
  </main>

  <style>
    .chart-container { position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
    .admin-profile { position: relative; cursor: pointer; }
    .admin-profile-dropdown { position: absolute; top: calc(100% + 8px); right: 0; width: 200px; background: #fff; border: 1px solid var(--admin-border); border-radius: var(--admin-radius-sm); box-shadow: 0 8px 30px rgba(0,0,0,0.1); z-index: 2000; display: none; padding: 6px; opacity: 0; transform: translateY(-4px); transition: opacity 0.2s ease, transform 0.2s ease; }
    .admin-profile-dropdown.show { display: block; opacity: 1; transform: translateY(0); }
    .admin-profile-dropdown .dropdown-item { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 8px; text-decoration: none; color: var(--admin-text-light); font-size: 0.88rem; font-weight: 500; transition: background 0.15s ease; }
    .admin-profile-dropdown .dropdown-item:hover { background: var(--admin-accent); color: var(--admin-primary-dark); }
    .admin-profile-dropdown .dropdown-item i { width: 18px; text-align: center; }
    .admin-profile-dropdown .dropdown-divider { height: 1px; background: var(--admin-border); margin: 4px 0; }
    .admin-profile-dropdown .dropdown-danger { color: #e88080; }
    .admin-profile-dropdown .dropdown-danger:hover { background: #fee2e2 !important; color: #991b1b !important; }
  </style>

  <script>
    function toggleSidebar() {
      document.getElementById('adminSidebar').classList.toggle('open');
      document.getElementById('sidebarOverlay').classList.toggle('show');
    }
    (function() {
      var toggle = document.getElementById('profileDropdownToggle');
      var dropdown = document.getElementById('profileDropdown');
      if (toggle && dropdown) {
        toggle.addEventListener('click', function(e) { e.stopPropagation(); dropdown.classList.toggle('show'); });
        document.addEventListener('click', function(e) { if (!toggle.contains(e.target) && !dropdown.contains(e.target)) { dropdown.classList.remove('show'); } });
      }
    })();

    document.addEventListener('DOMContentLoaded', function() {
      // Category Distribution Chart
      var catCanvas = document.getElementById('categoryChart');
      if (catCanvas) {
        var catCtx = catCanvas.getContext('2d');
        new Chart(catCtx, {
          type: 'doughnut',
          data: {
            labels: [<% if (catDistribution && catDistribution.length > 0) { %><% catDistribution.forEach(function(c, i) { %><%= i > 0 ? ',' : '' %>'<%= c.name %>'<% }); %><% } %>],
            datasets: [{
              data: [<% if (catDistribution) { %><% catDistribution.forEach(function(c, i) { %><%= i > 0 ? ',' : '' %><%= c.count %><% }); %><% } %>],
              backgroundColor: ['#c4956a','#7bc47f','#6ab0e8','#e88080','#f4c542','#a67bbf','#5b9bd5','#70ad47'],
              borderWidth: 0,
              hoverOffset: 8
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '60%',
            plugins: {
              legend: { position: 'bottom', labels: { padding: 12, usePointStyle: true, pointStyle: 'circle', font: { size: 11 }, color: '#4a3728' } }
            }
          }
        });
      }

      // User Registrations Chart
      var userCanvas = document.getElementById('userChart');
      if (userCanvas) {
        var userCtx = userCanvas.getContext('2d');
        new Chart(userCtx, {
          type: 'bar',
          data: {
            labels: [<% if (reportDays) { %><% reportDays.forEach(function(d, i) { %><%= i > 0 ? ',' : '' %>'<%= d %>'<% }); %><% } %>],
            datasets: [{
              label: 'New Users',
              data: [<% if (reportUserCounts) { %><% reportUserCounts.forEach(function(c, i) { %><%= i > 0 ? ',' : '' %><%= c %><% }); %><% } %>],
              backgroundColor: 'rgba(196,149,106,0.7)',
              borderColor: '#c4956a',
              borderWidth: 1,
              borderRadius: 4
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false }
            },
            scales: {
              y: { beginAtZero: true, ticks: { stepSize: 1 } }
            }
          }
        });
      }
    });
  </script>
</body>
</html>